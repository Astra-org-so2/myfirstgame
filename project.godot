; Engine configuration file.
; AFTER YOU — Godot 4.7.2-stable.
;
; Platform: Android first (ADR-021, mobile-first):
; - renderer Forward+ (Vulkan); mobile renderer = fallback, Phase 16 decision
; - landscape, canvas_items stretch + aspect expand (aspect 16:9-20:9, safe area)
; - ETC2/ASTC texture import for mobile VRAM compression
; - PC = dev/QA convenience only (same input map: kb/m + gamepad layouts)
;
; Autoloads (ADR-009 — each appears with its own system phase):
; EventBus — Phase 4 (combat events; RunManager/WorldDirector follow).

config_version=5

[autoload]

EventBus="*res://scripts/core/event_bus.gd"

[application]

config/name="AFTER YOU"
config/description="3D third-person action roguelite — the world remembers your previous runs."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)
, Object(InputEventKey,"physical_keycode":4194320)
]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)
, Object(InputEventKey,"physical_keycode":4194322)
]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)
, Object(InputEventKey,"physical_keycode":4194319)
]
}
